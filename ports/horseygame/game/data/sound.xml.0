<Sounds>

  <!--
    
    Sound Properties:
    vol="100"
    pitch="100"
    pitchlow="50"
    pitchhigh="200"

  -->

  <!--############# CHANGES #############-->

  <!--

  New sounds:
  DONE FillHole - plays when you drop an item into a hole, which fills it up and buries the item
  DONE DestroyTree - using shovel
  DONE DestroyMountain - using shovel
  DONE ReclaimLand - surround <=4 water tiles with fences
  DONE Fish
  DONE EnterLocationAbandoned
  DONE WhipCrack
  DONE BalloonFly

  
  -->

  
  <!--############# LOCATION SOUNDS #############-->

